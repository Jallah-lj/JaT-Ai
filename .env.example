# Environment: development | testing | staging | production
JAT_ENVIRONMENT=development
JAT_LOG_LEVEL=INFO
JAT_API_PREFIX=/api/v1

# Local database and Redis services
JAT_DATABASE_URL=postgresql+asyncpg://jat:20064@localhost:5432/jat
JAT_REDIS_URL=redis://localhost:6379/0

# Authentication
JAT_JWT_ISSUER=jat-api
JAT_JWT_AUDIENCE=jat-web
JAT_JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
JAT_ACCESS_TOKEN_TTL_MINUTES=15
JAT_REFRESH_TOKEN_TTL_DAYS=30

# Frontend origin — plain URL only; do not use [text](url) formatting.
JAT_CORS_ORIGINS='["http://localhost:5173"]'

# Request and authentication limits
JAT_REQUEST_MAX_BYTES=1048576
JAT_AUTH_RATE_LIMIT_ATTEMPTS=10
JAT_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Guest / trial access — visitors can experiment with the LLM before signing up
JAT_GUEST_ENABLED=true
JAT_GUEST_MESSAGE_LIMIT=10
JAT_GUEST_TTL_HOURS=24
JAT_GUEST_MAX_CONVERSATIONS=5

# AI model configuration
JAT_MODEL_PROVIDER=ollama
JAT_MODEL_NAME=llama3.1:latest
JAT_MODEL_ENDPOINT=http://127.0.0.1:11434
JAT_MODEL_CONTEXT_LENGTH=8192
JAT_MODEL_MAX_TOKENS=1024
JAT_MODEL_TEMPERATURE=0.2

# Default JaT behavior
JAT_DEFAULT_SYSTEM_PROMPT='You are JaT, a precise, helpful assistant. Answer clearly and concisely. If you are unsure, say so. Never invent facts, sources, or a back-story.'

# Knowledge base / RAG configuration
JAT_EMBEDDING_PROVIDER=ollama
JAT_EMBEDDING_MODEL=nomic-embed-text
JAT_EMBEDDING_ENDPOINT=http://127.0.0.1:11434
JAT_OBJECT_STORE_DIR=.jat-data/objects
JAT_INGESTION_DISPATCHER=inline
JAT_INGESTION_QUEUE=jat:ingestion
JAT_UPLOAD_MAX_BYTES=26214400
JAT_RAG_CHUNK_MAX_CHARS=1000
JAT_RAG_CHUNK_OVERLAP=200
JAT_RAG_SEARCH_LIMIT=8
JAT_RAG_MAX_CITATIONS=5
