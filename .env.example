# Environment: development | testing | staging | production
JAT_ENVIRONMENT=development
JAT_LOG_LEVEL=INFO
JAT_API_PREFIX=/api/v1
JAT_DATABASE_URL=postgresql+asyncpg://jat:jat_dev_password@postgres:5432/jat
JAT_REDIS_URL=redis://redis:6379/0
JAT_JWT_ISSUER=jat-api
JAT_JWT_AUDIENCE=jat-web
# Generate a unique value of at least 32 characters outside local development.
JAT_JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
JAT_ACCESS_TOKEN_TTL_MINUTES=15
JAT_REFRESH_TOKEN_TTL_DAYS=30
JAT_CORS_ORIGINS=http://localhost:5173
JAT_REQUEST_MAX_BYTES=1048576
JAT_AUTH_RATE_LIMIT_ATTEMPTS=10
JAT_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Phase 2 model routing. The deterministic provider is a test/dev fixture, not an LLM.
JAT_MODEL_PROVIDER=ollama
JAT_MODEL_NAME=llama3.1
JAT_MODEL_ENDPOINT=http://127.0.0.1:11434
JAT_MODEL_CONTEXT_LENGTH=8192
JAT_MODEL_MAX_TOKENS=1024
JAT_MODEL_TEMPERATURE=0.2
# Operator-level baseline persona applied only when a user has no system prompt of their own.
JAT_DEFAULT_SYSTEM_PROMPT=You are JaT, a precise, helpful assistant. If unsure, say so. Never invent a persona or back-story.

# Phase 3 governed ingestion and retrieval. The deterministic embedding provider is a
# test/dev fixture, not a semantic embedding model. inline dispatch processes uploads
# synchronously; redis dispatch requires running `python -m jat_api.ingestion.worker`.
JAT_EMBEDDING_PROVIDER=deterministic
JAT_OBJECT_STORE_DIR=.jat-data/objects
JAT_INGESTION_DISPATCHER=inline
JAT_INGESTION_QUEUE=jat:ingestion
JAT_UPLOAD_MAX_BYTES=26214400
JAT_RAG_CHUNK_MAX_CHARS=1000
JAT_RAG_CHUNK_OVERLAP=200
JAT_RAG_SEARCH_LIMIT=8
JAT_RAG_MAX_CITATIONS=5
